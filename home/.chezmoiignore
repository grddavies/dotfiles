{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin/**
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/linux/**
.config/zsh/funcs/setBrightness
{{ end }}

{{ if not .tidal }}
.chezmoiscripts/**/*install-tidal*.*
{{ end }}

{{ if .work }}
.chezmoiscripts/**/*install-apps-home*.*
{{ else }}
.chezmoiscripts/**/*install-apps-work*.*
.config/zsh/funcs/start-ssm
.chezmoiscripts/**/*install-packages-work*.*
{{ end }}

{{ if .headless }}
.chezmoiscripts/*install-haskell*
.chezmoiscripts/*install-rust*
# macbook automation
.sleep
.wakeup
# linux apps
.chezmoiscripts/linux/*install-kitty.*
.chezmoiscripts/linux/*install-snaps.*
.chezmoiscripts/linux/*install-apt-apps.*
.chezmoiscripts/linux/*install-brew-extras.*
.chezmoiscripts/linux/*install-vscode.*
.chezmoiscripts/linux/*setup-kanata.*
{{ end }}
