# start-ssm <instance-id> [local-port]
# Port-forward RDP (3389) from a legacy EC2 instance via AWS SSM.
# Then RDP to localhost:<local-port> (default 12345).
function start-ssm {
  if [[ $# -lt 1 || $# -gt 2 || $1 == -h || $1 == --help ]]; then
    print "Usage: $funcstack[1] <instance-id> [local-port (default 12345)]"
    return 1
  fi

  local target=$1 local_port=${2:-12345}

  aws ssm start-session \
    --region eu-west-2 \
    --target "$target" \
    --document-name AWS-StartPortForwardingSession \
    --parameters "{\"portNumber\":[\"3389\"],\"localPortNumber\":[\"$local_port\"]}"
}
